Screen {
    background: $surface;
    color: $text;
}

#layout {
    height: 1fr;
}

#sidebar {
    width: 18;
    min-width: 14;
    padding: 1 2;
    background: $panel;
    color: $text-muted;
    border-right: solid $primary;
}

#screen-host {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#search-input,
#chapter-filter {
    margin-bottom: 1;
}

#chapter-tools,
#download-actions {
    height: auto;
    margin-bottom: 1;
}

#format-select {
    width: 16;
}

#download-button,
#cancel-button,
#cleanup-button {
    width: auto;
}

DataTable {
    height: 1fr;
}

.pane-title {
    text-style: bold;
    margin-bottom: 1;
}

.muted {
    color: $text-muted;
}

.error {
    color: $error;
}

.success {
    color: $success;
}
