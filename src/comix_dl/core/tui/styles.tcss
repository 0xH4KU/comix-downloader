Screen {
    background: $surface;
    color: $text;
}

#layout {
    height: 1fr;
}

#sidebar {
    width: 22;
    min-width: 18;
    height: 1fr;
    padding: 1 1;
    background: $panel;
    color: $text-muted;
    border-right: solid $primary;
}

.nav-section {
    text-style: bold;
    color: $primary;
    margin-top: 1;
}

.nav-item {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.nav-item:hover,
.nav-item:focus {
    background: $boost;
    color: $text;
}

.nav-item.active {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

#screen-host {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#status-log {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    border-top: solid $surface-lighten-1;
}

#status-log.expanded {
    height: 5;
}

#search-input,
#chapter-filter {
    margin-bottom: 1;
}

.helper-text,
.empty-state {
    margin-bottom: 1;
}

#selection-summary,
#download-summary,
#series-meta {
    margin-bottom: 1;
}

#chapter-tools,
#download-actions {
    height: auto;
    margin-bottom: 1;
}

#format-select {
    width: 16;
}

#download-button,
#cancel-button,
#cleanup-button {
    width: auto;
}

DataTable {
    height: 1fr;
}

.pane-title {
    text-style: bold;
    margin-bottom: 1;
}

.muted {
    color: $text-muted;
}

.error {
    color: $error;
}

.success {
    color: $success;
}
